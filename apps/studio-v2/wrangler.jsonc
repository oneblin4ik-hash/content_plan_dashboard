{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crimson-studio",
  // Воркер создан мастером импорта, и адрес на workers.dev у него оказался
  // выключен: деплой проходил, а страница отдавала 404 и error code 1042.
  // Указано явно, чтобы каждая выкладка включала адрес заново.
  "workers_dev": true,
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crimson-studio",
      "database_id": "aa3c3882-1bc2-42eb-af47-1e44058a96f7",
      "migrations_dir": "db/migrations"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "LLM_PROVIDER": "gemini",
    "LLM_MODEL": "gemini-2.5-flash",
    "DAILY_GENERATION_LIMIT": "20"
  }
}
